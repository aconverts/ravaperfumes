ay.selected_or_first_available_variant.id\n    if sibling_ids != \"\"\n      assign sibling_ids = sibling_ids | append: \",\"\n    endif\n    assign sibling_ids = sibling_ids | append: spray_vid\n    if sibling_types != \"\"\n      assign sibling_types = sibling_types | append: \" & \"\n    endif\n    assign sibling_types = sibling_types | append: \"Home Spray\"\n  endif\n\n  if roll_on != blank and roll_on.id != product.id and roll_on.available\n    assign count = count | plus: 1\n    assign roll_on_vid = roll_on.selected_or_first_available_variant.id\n    if sibling_ids != \"\"\n      assign sibling_ids = sibling_ids | append: \",\"\n    endif\n    assign sibling_ids = sibling_ids | append: roll_on_vid\n    if sibling_types != \"\"\n      assign sibling_types = sibling_types | append: \" & \"\n    endif\n    assign sibling_types = sibling_types | append: \"Roll On\"\n  endif\n\n  if hair_mist != blank and hair_mist.id != product.id and hair_mist.available\n    assign count = count | plus: 1\n    assign hair_mist_vid = hair_mist.selected_or_first_available_variant.id\n    if sibling_ids != \"\"\n      assign sibling_ids = sibling_ids | append: \",\"\n    endif\n    assign sibling_ids = sibling_ids | append: hair_mist_vid\n    if sibling_types != \"\"\n      assign sibling_types = sibling_types | append: \" & \"\n    endif\n    assign sibling_types = sibling_types | append: \"Hair Mist\"\n  endif\n\n  if body_splash != blank and body_splash.id != product.id and body_splash.available\n    assign count = count | plus: 1\n    assign body_splash_vid = body_splash.selected_or_first_available_variant.id\n    if sibling_ids != \"\"\n      assign sibling_ids = sibling_ids | append: \",\"\n    endif\n    assign sibling_ids = sibling_ids | append: body_splash_vid\n    if sibling_types != \"\"\n      assign sibling_types = sibling_types | append: \" & \"\n    endif\n    assign sibling_types = sibling_types | append: \"Body Splash\"\n  endif\n-%}\n\n{%- if count > 0 -%}\n<div class=\"complementary-products\" id=\"scent-siblings\">\n  {%- comment -%} ---- DYNAMIC HEADING ---- {%- endcomment -%}\n  <div class=\"complementary-products__header\">\n    <p class=\"h5\">Get The Full {{ scent_name }} Collection, BUNDLE & SAVE 25%</p>\n  </div>\n  {%- comment -%} ---- PRODUCT LIST ---- {%- endcomment -%}\n  <div class=\"complementary-products__product-list\">\n\n    {%- comment -%} === OIL === {%- endcomment -%}\n    {%- if oil != blank and oil.id != product.id and oil.available -%}\n      <div class=\"horizontal-product-card\">\n        {%- if oil.featured_media -%}\n          <a href=\"{{ oil.url }}\" class=\"horizontal-product-card__figure scent-figure\" data-instant>\n            <span class=\"scent-badge\">Tanning Oil</span>\n            {{- oil.featured_media | image_url: width: oil.featured_media.width | image_tag: loading: 'lazy', sizes: '100px', widths: '100,150,200,250,300', class: 'horizontal-product-card__image scent-img' -}}\n          </a>\n        {%- endif -%}\n        <div class=\"horizontal-product-card__info\">\n          <div class=\"v-stack gap-1 justify-items-start\">\n            <a href=\"{{ oil.url }}\" class=\"product-title {% if settings.product_card_text_font == 'heading' %}h6{% endif %}\" data-instant>{{ oil.title }}</a>\n            {%- render 'price-list', product: oil, context: 'card' -%}\n          </div>\n          {%- if oil.available -%}\n            <product-form>\n              {%- form 'product', oil -%}\n                <input type=\"hidden\" name=\"id\" value=\"{{ oil.selected_or_first_available_variant.id }}\">\n                <input type=\"hidden\" name=\"quantity\" value=\"1\">\n                <input type=\"hidden\" name=\"on_success\" value=\"force_open_drawer\">\n                <button type=\"submit\" class=\"@narrow:horizontal-product-card__button link\">{{ 'product.general.add_to_cart_button' | t }}</button>\n                <button type=\"submit\" class=\"@large:horizontal-product-card__button button button--outline button--subdued\">{{ 'product.general.add_to_cart_button' | t }}</button>\n              {%- endform -%}\n            </product-form>\n          {%- endif -%}\n        </div>\n      </div>\n    {%- endif -%}\n\n    {%- comment -%} === PERFUME === {%- endcomment -%}\n    {%- if perfume != blank and perfume.id != product.id and perfume.available -%}\n      <div class=\"horizontal-product-card\">\n        {%- if perfume.featured_media -%}\n          <a href=\"{{ perfume.url }}\" class=\"horizontal-product-card__figure scent-figure\" data-instant>\n            <span class=\"scent-badge\">Perfume</span>\n            {{- perfume.featured_media | image_url: width: perfume.featured_media.width | image_tag: loading: 'lazy', sizes: '100px', widths: '100,150,200,250,300', class: 'horizontal-product-card__image scent-img' -}}\n          </a>\n        {%- endif -%}\n        <div class=\"horizontal-product-card__info\">\n          <div class=\"v-stack gap-1 justify-items-start\">\n            <a href=\"{{ perfume.url }}\" class=\"product-title {% if settings.product_card_text_font == 'heading' %}h6{% endif %}\" data-instant>{{ perfume.title }}</a>\n            {%- render 'price-list', product: perfume, context: 'card' -%}\n          </div>\n          {%- if perfume.available -%}\n            <product-form>\n              {%- form 'product', perfume -%}\n                <input type=\"hidden\" name=\"id\" value=\"{{ perfume.selected_or_first_available_variant.id }}\">\n                <input type=\"hidden\" name=\"quantity\" value=\"1\">\n                <input type=\"hidden\" name=\"on_success\" value=\"force_open_drawer\">\n                <button type=\"submit\" class=\"@narrow:horizontal-product-card__button link\">{{ 'product.general.add_to_cart_button' | t }}</button>\n                <button type=\"submit\" class=\"@large:horizontal-product-card__button button button--outline button--subdued\">{{ 'product.general.add_to_cart_button' | t }}</button>\n              {%- endform -%}\n            </product-form>\n          {%- endif -%}\n        </div>\n      </div>\n    {%- endif -%}\n\n    {%- comment -%} === SPRAY === {%- endcomment -%}\n    {%- if spray != blank and spray.id != product.id and spray.available -%}\n      <div class=\"horizontal-product-card\">\n        {%- if spray.featured_media -%}\n          <a href=\"{{ spray.url }}\" class=\"horizontal-product-card__figure scent-figure\" data-instant>\n            <span class=\"scent-badge\">Home Spray</span>\n            {{- spray.featured_media | image_url: width: spray.featured_media.width | image_tag: loading: 'lazy', sizes: '100px', widths: '100,150,200,250,300', class: 'horizontal-product-card__image scent-img' -}}\n          </a>\n        {%- endif -%}\n        <div class=\"horizontal-product-card__info\">\n          <div class=\"v-stack gap-1 justify-items-start\">\n            <a href=\"{{ spray.url }}\" class=\"product-title {% if settings.product_card_text_font == 'heading' %}h6{% endif %}\" data-instant>{{ spray.title }}</a>\n            {%- render 'price-list', product: spray, context: 'card' -%}\n          </div>\n          {%- if spray.available -%}\n            <product-form>\n              {%- form 'product', spray -%}\n                <input type=\"hidden\" name=\"id\" value=\"{{ spray.selected_or_first_available_variant.id }}\">\n                <input type=\"hidden\" name=\"quantity\" value=\"1\">\n                <input type=\"hidden\" name=\"on_success\" value=\"force_open_drawer\">\n                <button type=\"submit\" class=\"@narrow:horizontal-product-card__button link\">{{ 'product.general.add_to_cart_button' | t }}</button>\n                <button type=\"submit\" class=\"@large:horizontal-product-card__button button button--outline button--subdued\">{{ 'product.general.add_to_cart_button' | t }}</button>\n              {%- endform -%}\n            </product-form>\n          {%- endif -%}\n        </div>\n      </div>\n    {%- endif -%}\n\n    {%- comment -%} === ROLL ON === {%- endcomment -%}\n    {%- if roll_on != blank and roll_on.id != product.id and roll_on.available -%}\n      <div class=\"horizontal-product-card\">\n        {%- if roll_on.featured_media -%}\n          <a href=\"{{ roll_on.url }}\" class=\"horizontal-product-card__figure scent-figure\" data-instant>\n            <span class=\"scent-badge\">Roll On</span>\n            {{- roll_on.featured_media | image_url: width: roll_on.featured_media.width | image_tag: loading: 'lazy', sizes: '100px', widths: '100,150,200,250,300', class: 'horizontal-product-card__image scent-img' -}}\n          </a>\n        {%- endif -%}\n        <div class=\"horizontal-product-card__info\">\n          <div class=\"v-stack gap-1 justify-items-start\">\n            <a href=\"{{ roll_on.url }}\" class=\"product-title {% if settings.product_card_text_font == 'heading' %}h6{% endif %}\" data-instant>{{ roll_on.title }}</a>\n            {%- render 'price-list', product: roll_on, context: 'card' -%}\n          </div>\n          {%- if roll_on.available -%}\n            <product-form>\n              {%- form 'product', roll_on -%}\n                <input type=\"hidden\" name=\"id\" value=\"{{ roll_on.selected_or_first_available_variant.id }}\">\n                <input type=\"hidden\" name=\"quantity\" value=\"1\">\n                <input type=\"hidden\" name=\"on_success\" value=\"force_open_drawer\">\n                <button type=\"submit\" class=\"@narrow:horizontal-product-card__button link\">{{ 'product.general.add_to_cart_button' | t }}</button>\n                <button type=\"submit\" class=\"@large:horizontal-product-card__button button button--outline button--subdued\">{{ 'product.general.add_to_cart_button' | t }}</button>\n              {%- endform -%}\n            </product-form>\n          {%- endif -%}\n        </div>\n      </div>\n    {%- endif -%}\n\n    {%- comment -%} === HAIR MIST === {%- endcomment -%}\n    {%- if hair_mist != blank and hair_mist.id != product.id and hair_mist.available -%}\n      <div class=\"horizontal-product-card\">\n        {%- if hair_mist.featured_media -%}\n          <a href=\"{{ hair_mist.url }}\" class=\"horizontal-product-card__figure scent-figure\" data-instant>\n            <span class=\"scent-badge\">Hair Mist</span>\n            {{- hair_mist.featured_media | image_url: width: hair_mist.featured_media.width | image_tag: loading: 'lazy', sizes: '100px', widths: '100,150,200,250,300', class: 'horizontal-product-card__image scent-img' -}}\n          </a>\n        {%- endif -%}\n        <div class=\"horizontal-product-card__info\">\n          <div class=\"v-stack gap-1 justify-items-start\">\n            <a href=\"{{ hair_mist.url }}\" class=\"product-title {% if settings.product_card_text_font == 'heading' %}h6{% endif %}\" data-instant>{{ hair_mist.title }}</a>\n            {%- render 'price-list', product: hair_mist, context: 'card' -%}\n          </div>\n          {%- if hair_mist.available -%}\n            <product-form>\n              {%- form 'product', hair_mist -%}\n                <input type=\"hidden\" name=\"id\" value=\"{{ hair_mist.selected_or_first_available_variant.id }}\">\n                <input type=\"hidden\" name=\"quantity\" value=\"1\">\n                <input type=\"hidden\" name=\"on_success\" value=\"force_open_drawer\">\n                <button type=\"submit\" class=\"@narrow:horizontal-product-card__button link\">{{ 'product.general.add_to_cart_button' | t }}</button>\n                <button type=\"submit\" class=\"@large:horizontal-product-card__button button button--outline button--subdued\">{{ 'product.general.add_to_cart_button' | t }}</button>\n              {%- endform -%}\n            </product-form>\n          {%- endif -%}\n        </div>\n      </div>\n    {%- endif -%}\n\n    {%- comment -%} === BODY SPLASH === {%- endcomment -%}\n    {%- if body_splash != blank and body_splash.id != product.id and body_splash.available -%}\n      <div class=\"horizontal-product-card\">\n        {%- if body_splash.featured_media -%}\n          <a href=\"{{ body_splash.url }}\" class=\"horizontal-product-card__figure scent-figure\" data-instant>\n            <span class=\"scent-badge\">Body Splash</span>\n            {{- body_splash.featured_media | image_url: width: body_splash.featured_media.width | image_tag: loading: 'lazy', sizes: '100px', widths: '100,150,200,250,300', class: 'horizontal-product-card__image scent-img' -}}\n          </a>\n        {%- endif -%}\n        <div class=\"horizontal-product-card__info\">\n          <div class=\"v-stack gap-1 justify-items-start\">\n            <a href=\"{{ body_splash.url }}\" class=\"product-title {% if settings.product_card_text_font == 'heading' %}h6{% endif %}\" data-instant>{{ body_splash.title }}</a>\n            {%- render 'price-list', product: body_splash, context: 'card' -%}\n          </div>\n          {%- if body_splash.available -%}\n            <product-form>\n              {%- form 'product', body_splash -%}\n                <input type=\"hidden\" name=\"id\" value=\"{{ body_splash.selected_or_first_available_variant.id }}\">\n                <input type=\"hidden\" name=\"quantity\" value=\"1\">\n                <input type=\"hidden\" name=\"on_success\" value=\"force_open_drawer\">\n                <button type=\"submit\" class=\"@narrow:horizontal-product-card__button link\">{{ 'product.general.add_to_cart_button' | t }}</button>\n                <button type=\"submit\" class=\"@large:horizontal-product-card__button button button--outline button--subdued\">{{ 'product.general.add_to_cart_button' | t }}</button>\n              {%- endform -%}\n            </product-form>\n          {%- endif -%}\n        </div>\n      </div>\n    {%- endif -%}\n\n  </div>\n\n  {%- comment -%} ---- ADD ALL TO CART ---- {%- endcomment -%}\n  {%- if count >= 2 -%}\n    <div class=\"scent-add-all\">\n      <button type=\"button\" class=\"scent-add-all__button button button--subdued\" data-scent-add-all=\"{{ sibling_ids }}\">\n        Add all {{ count }} to cart\n      </button>\n      <p class=\"scent-add-all__hint\">Complete your collection. One scent, every format.</p>\n    </div>\n  {%- endif -%}\n</div>\n\n<style>\n  .scent-figure {\n    position: relative;\n    overflow: hidden;\n  }\n  .scent-img,\n  .scent-figure {\n    border-radius: 10px !important;\n  }\n  .scent-badge {\n    position: absolute;\n    bottom: 4px;\n    left: 4px;\n    z-index: 2;\n    font-size: 0.5625rem;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    padding: 2px 7px;\n    border-radius: 3px;\n    line-height: 1.4;\n    pointer-events: none;\n    background: #FFEDAC;\n    color: #000;\n  }\n  .scent-add-all {\n    text-align: center;\n    padding-top: 0.25rem;\n  }\n  .scent-add-all__button {\n    width: 100%;\n  }\n  .scent-add-all__hint {\n    margin-top: 0.5rem;\n    font-size: 0.75rem;\n    opacity: 0.5;\n  }\n</style>\n\n<script>\n  (function() {\n    document.querySelectorAll('[data-scent-add-all]').forEach(function(btn) {\n      btn.addEventListener('click', function() {\n        var ids = btn.getAttribute('data-scent-add-all').split(',');\n        var items = ids.map(function(id) {\n          return { id: parseInt(id, 10), quantity: 1 };\n        });\n        var originalText = btn.textContent;\n        btn.textContent = 'Adding...';\n        btn.disabled = true;\n        fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ items: items })\n        })\n        .then(function(res) {\n          if (!res.ok) throw new Error('Failed');\n          return res.json();\n        })\n        .then(function() {\n          btn.textContent = 'Added ✓';\n          setTimeout(function() {\n            btn.textContent = originalText;\n            btn.disabled = false;\n          }, 2000);\n          document.documentElement.dispatchEvent(\n            new CustomEvent('cart:refresh', { bubbles: true })\n          );\n        })\n        .catch(function() {\n          btn.textContent = 'Error — try again';\n          btn.disabled = false;\n          setTimeout(function() { btn.textContent = originalText; }, 2500);\n        });\n      });\n    });\n  })();\n</script>\n{%- endif -%}"
