        "liquid_KqBEcN": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<div class=\"mothersday-bundle-timer\">\n  <div class=\"rbt-label\">\n  🐣 Easter Sale Ends In:\n</div>\n\n  <div class=\"rbt-values\">\n    <div class=\"rbt-time-box\">\n      <span id=\"rbt-days\">00</span>\n      <small>Days</small>\n    </div>\n    <div class=\"rbt-time-box\">\n      <span id=\"rbt-hours\">00</span>\n      <small>Hours</small>\n    </div>\n    <div class=\"rbt-time-box\">\n      <span id=\"rbt-minutes\">00</span>\n      <small>Minutes</small>\n    </div>\n    <div class=\"rbt-time-box\">\n      <span id=\"rbt-seconds\">00</span>\n      <small>Seconds</small>\n    </div>\n  </div>\n</div>\n\n<style>\n\n.mothersday-bundle-timer{\n  margin:0 !important;\n  padding:12px 10px !important;\n  text-align:center;\n  background:#efe4bf\n;\n}\n\n.rbt-label{\n  font-size:15px;\n  font-weight:700;\n  margin-bottom:8px;\n  color:#000;\n}\n\n.rbt-values{\n  display:flex;\n  justify-content:center;\n  gap:6px;\n  margin-bottom:8px;\n}\n\n.rbt-time-box{\n  background:#ffffff;\n  color:#000;\n  padding:6px 6px;\n  min-width:50px;\n  text-align:center;\n  border-radius:5px;\n  box-shadow:0 1px 4px rgba(0,0,0,0.08);\n}\n\n.rbt-time-box span{\n  display:block;\n  font-size:16px;\n  font-weight:800;\n  line-height:1.1;\n}\n\n.rbt-time-box small{\n  font-size:8px;\n  text-transform:uppercase;\n  letter-spacing:0.05em;\n  margin-top:2px;\n  display:block;\n}\n\n.rbt-cta-button{\n  width:100%;\n  margin-top:6px;\n  background:#ffffff;\n  border:2px solid #ffffff;\n  color:#C46B78;\n  text-decoration:none;\n  display:inline-block;\n  padding:8px 0;\n  font-weight:700;\n  border-radius:5px;\n  font-size:13px;\n  transition:all .25s ease;\n}\n\n.rbt-cta-button:hover{\n  background:#f8e4e7;\n  border-color:#f8e4e7;\n}\n\n/* Desktop layout */\n@media (min-width: 768px){\n\n.mothersday-bundle-timer{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  gap:18px;\n  padding:14px 20px !important;\n}\n\n.rbt-label{\n  margin-bottom:0;\n  font-size:18px;\n}\n\n.rbt-values{\n  margin-bottom:0;\n  gap:10px;\n}\n\n/* Bigger countdown boxes */\n.rbt-time-box{\n  padding:10px 12px;\n  min-width:70px;\n}\n\n.rbt-time-box span{\n  font-size:26px;\n}\n\n.rbt-time-box small{\n  font-size:10px;\n}\n\n/* Smaller button on same line */\n.rbt-cta-button{\n  width:auto;\n  margin-top:0;\n  padding:10px 18px;\n  font-size:14px;\n}\n\n}\n</style>\n\n<script>\n/* Dynamic: ends in 2 days + 20 hours from NOW */\nconst now = new Date().getTime();\nconst endDate = now + ((2 * 24 + 20) * 60 * 60 * 1000);\n\nsetInterval(function() {\n  const currentTime = new Date().getTime();\n  const distance = endDate - currentTime;\n\n  if (distance <= 0) {\n    document.getElementById(\"rbt-days\").innerHTML = \"00\";\n    document.getElementById(\"rbt-hours\").innerHTML = \"00\";\n    document.getElementById(\"rbt-minutes\").innerHTML = \"00\";\n    document.getElementById(\"rbt-seconds\").innerHTML = \"00\";\n    return;\n  }\n\n  const days = Math.floor(distance / (1000 * 60 * 60 * 24));\n  const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n  const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));\n  const seconds = Math.floor((distance % (1000 * 60)) / 1000);\n\n  document.getElementById(\"rbt-days\").innerHTML = String(days).padStart(2, '0');\n  document.getElementById(\"rbt-hours\").innerHTML = String(hours).padStart(2, '0');\n  document.getElementById(\"rbt-minutes\").innerHTML = String(minutes).padStart(2, '0');\n  document.getElementById(\"rbt-seconds\").innerHTML = String(seconds).padStart(2, '0');\n}, 1000);\n</script>"
          }
        },
        "liquid_kGr9BD": {
          "type": "liquid",
          "settings": {
            "liquid": "<div class=\"delivery-premium\">\n  <div class=\"delivery-label\">\n    <span class=\"status-dot\"></span>\n    Delivery time\n  </div>\n\n  <div class=\"delivery-text\">\n    Order now · Arrives by <strong id=\"delivery-dates\"></strong>\n  </div>\n</div>\n\n<style>\n  .delivery-premium {\n    margin: 14px 0;\n    padding: 12px 14px;\n    border: 1px solid rgba(0, 0, 0, 0.08);\n    background: rgba(0, 0, 0, 0.02);\n    border-radius: 8px;\n  }\n\n  .delivery-label {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    color: rgba(0, 0, 0, 0.6);\n    margin-bottom: 6px;\n  }\n\n  .status-dot {\n    width: 6px;\n    height: 6px;\n    background: #e10600;\n    border-radius: 50%;\n  }\n\n  .delivery-text {\n    font-size: 14px;\n    color: #111;\n    line-height: 1.4;\n  }\n\n  .delivery-text strong {\n    font-weight: 600;\n  }\n</style>\n\n<script>\n  (function () {\n\n    function addBusinessDays(date, days) {\n      let result = new Date(date);\n      let added = 0;\n\n      while (added < days) {\n        result.setDate(result.getDate() + 1);\n        const day = result.getDay();\n\n        // Skip Saturday (6) and Sunday (0)\n        if (day !== 0 && day !== 6) {\n          added++;\n        }\n      }\n\n      return result;\n    }\n\n    const today = new Date();\n\n    const minDate = addBusinessDays(today, 4);\n    const maxDate = addBusinessDays(today, 5);\n\n    const format = (date) =>\n      date.toLocaleDateString('en-US', {\n        weekday: 'short',\n        month: 'short',\n        day: 'numeric'\n      });\n\n    const el = document.getElementById('delivery-dates');\n    if (el) {\n      el.textContent = format(minDate) + ' – ' + format(maxDate);\n    }\n\n  })();\n</script>"
          }
        },
