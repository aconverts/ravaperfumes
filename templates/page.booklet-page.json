        "liquid": "{%- comment -%}\n  RAVA FLIPBOOK  |  Custom Liquid block\n  -------------------------------------------------------------\n  MODE A (default): upload the page images to Settings > Files named\n  rava-book-01.jpg ... rava-book-24.jpg. Nothing else to edit.\n\n  MODE B (manual URLs): paste the image URLs into rava_fb_urls below,\n  in page order, separated by commas. If rava_fb_urls is not empty,\n  it is used instead of MODE A.\n{%- endcomment -%}\n{%- liquid\n  assign rava_fb_prefix = 'rava-book-'\n  assign rava_fb_ext = '.jpg'\n  assign rava_fb_count = 24\n  assign rava_fb_urls = ''\n\n  assign rava_fb_list = ''\n  if rava_fb_urls != blank\n    assign rava_fb_list = rava_fb_urls | strip_newlines | split: ','\n  else\n    assign rava_fb_joined = ''\n    for i in (1..rava_fb_count)\n      assign rava_fb_num = i | prepend: '0' | slice: -2, 2\n      assign rava_fb_name = rava_fb_prefix | append: rava_fb_num | append: rava_fb_ext\n      assign rava_fb_url = rava_fb_name | file_url\n      if forloop.first\n        assign rava_fb_joined = rava_fb_url\n      else\n        assign rava_fb_joined = rava_fb_joined | append: '|~|' | append: rava_fb_url\n      endif\n    endfor\n    assign rava_fb_list = rava_fb_joined | split: '|~|'\n  endif\n  assign rava_fb_total = rava_fb_list.size\n-%}\n\n<div class=\"rava-fb\" id=\"rava-fb-{{ section.id | default: 'main' }}\" data-rava-fb data-page-w=\"2000\" data-page-h=\"1410\" role=\"region\" aria-label=\"RAVA digital booklet\" tabindex=\"-1\">\n  <div class=\"rava-fb__viewport\">\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__arrow rava-fb__arrow--prev\" data-rava-prev aria-label=\"Previous page\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>\n    </button>\n\n    <div class=\"rava-fb__col\">\n      <div class=\"rava-fb__stage\">\n        <div class=\"rava-fb__book\" data-rava-book>\n          {%- for rava_fb_src in rava_fb_list -%}\n            <div class=\"rava-fb__page\"{% if forloop.first or forloop.last %} data-density=\"hard\"{% endif %}>\n              <img data-rava-src=\"{{ rava_fb_src | strip }}\" alt=\"RAVA booklet, page {{ forloop.index }} of {{ rava_fb_total }}\" width=\"2000\" height=\"1410\" draggable=\"false\" decoding=\"async\">\n            </div>\n          {%- endfor -%}\n        </div>\n      </div>\n    </div>\n\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__arrow rava-fb__arrow--next\" data-rava-next aria-label=\"Next page\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg>\n    </button>\n  </div>\n\n  <div class=\"rava-fb__bar\">\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__mini rava-fb__mini--nav\" data-rava-prev aria-label=\"Previous page\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>\n    </button>\n    <span class=\"rava-fb__count\" data-rava-count aria-live=\"polite\">1 / {{ rava_fb_total }}</span>\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__mini rava-fb__mini--nav\" data-rava-next aria-label=\"Next page\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg>\n    </button>\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__mini rava-fb__fs\" data-rava-fs aria-label=\"Enter fullscreen\">\n      <svg class=\"rava-fb__ico-open\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5\"/></svg>\n      <svg class=\"rava-fb__ico-close\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5\"/></svg>\n    </button>\n  </div>\n</div>\n\n<style>\n  .rava-fb {\n    --rfb-ink: #161616;\n    --rfb-muted: #8c8c8c;\n    --rfb-line: rgba(0, 0, 0, .12);\n    --rfb-paper: #fbfaf7;\n    --rfb-shift: 0px;\n    position: relative;\n    width: 100%;\n    max-width: 100%;\n    margin: 0 auto;\n    padding: clamp(16px, 3vw, 44px) 0 clamp(12px, 2vw, 28px);\n    box-sizing: border-box;\n    background: transparent;\n    overflow: hidden;\n    outline: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .rava-fb *, .rava-fb *::before, .rava-fb *::after { box-sizing: border-box; }\n\n  .rava-fb__viewport {\n    display: grid;\n    grid-template-columns: 52px minmax(0, 1fr) 52px;\n    align-items: center;\n    gap: clamp(8px, 1.5vw, 24px);\n  }\n  .rava-fb__col { min-width: 0; width: 100%; }\n\n  .rava-fb__stage {\n    position: relative;\n    width: 100%;\n    margin: 0 auto;\n    transform: translate3d(var(--rfb-shift), 0, 0);\n    transition: transform .85s cubic-bezier(.45, .05, .25, 1);\n    will-change: transform;\n  }\n  .rava-fb:not(.is-ready) .rava-fb__stage { aspect-ratio: 4000 / 1410; }\n  .rava-fb:not(.is-ready) .rava-fb__book { position: absolute; inset: 0; overflow: hidden; opacity: 0; }\n\n  /* Library container overrides (scoped) */\n  .rava-fb .rava-fb__book.stf__parent {\n    min-width: 0 !important;\n    min-height: 0 !important;\n    max-width: 100% !important;\n    margin: 0 auto;\n    touch-action: pan-y pinch-zoom;\n    opacity: 1;\n    transition: opacity .5s ease;\n  }\n  .rava-fb .rava-fb__book .stf__block {\n    filter: drop-shadow(0 22px 30px rgba(0, 0, 0, .13)) drop-shadow(0 4px 8px rgba(0, 0, 0, .07));\n  }\n\n  /* Pages */\n  .rava-fb .rava-fb__page {\n    background: var(--rfb-paper);\n    overflow: hidden;\n    user-select: none;\n    -webkit-user-select: none;\n  }\n  .rava-fb .rava-fb__page img {\n    display: block;\n    width: 100% !important;\n    height: 100% !important;\n    max-width: none !important;\n    object-fit: cover;\n    opacity: 0;\n    transition: opacity .35s ease;\n    pointer-events: none;\n    -webkit-user-drag: none;\n  }\n  .rava-fb .rava-fb__page.is-loaded img { opacity: 1; }\n  .rava-fb .rava-fb__page:not(.is-loaded)::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(100deg, rgba(0,0,0,0) 30%, rgba(0,0,0,.035) 50%, rgba(0,