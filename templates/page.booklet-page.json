p: round;\n    stroke-linejoin: round;\n  }\n  .rava-fb .rava-fb__btn:hover { border-color: var(--rfb-ink); }\n  .rava-fb .rava-fb__btn:active { transform: scale(.94); }\n  .rava-fb .rava-fb__btn:focus-visible { outline: 2px solid var(--rfb-ink); outline-offset: 2px; }\n  .rava-fb .rava-fb__btn[disabled] { opacity: .28; cursor: default; pointer-events: none; }\n\n  .rava-fb .rava-fb__arrow { width: 52px; height: 52px; }\n  .rava-fb .rava-fb__arrow svg { width: 22px; height: 22px; stroke-width: 1.2; }\n\n  .rava-fb__bar {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    margin-top: clamp(16px, 2.2vw, 28px);\n  }\n  .rava-fb .rava-fb__mini { width: 40px; height: 40px; }\n  .rava-fb .rava-fb__mini--nav { display: none; }\n  .rava-fb__count {\n    min-width: 76px;\n    text-align: center;\n    font-size: 13px;\n    letter-spacing: .14em;\n    font-variant-numeric: tabular-nums;\n    color: var(--rfb-muted);\n    white-space: nowrap;\n  }\n  .rava-fb .rava-fb__ico-close { display: none; }\n  .rava-fb.is-fs .rava-fb__ico-open { display: none; }\n  .rava-fb.is-fs .rava-fb__ico-close { display: block; }\n\n  /* Fullscreen (native + iPhone fallback) */\n  .rava-fb.is-fs {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    width: 100vw;\n    height: 100vh;\n    height: 100dvh;\n    max-width: none;\n    margin: 0;\n    padding: 20px 16px;\n    background: #fff;\n  }\n  .rava-fb.is-pseudo-fs { position: fixed; inset: 0; z-index: 2147483000; }\n  .rava-fb::backdrop { background: #fff; }\n\n  /* Fallback if the flip library cannot load: simple vertical pages */\n  .rava-fb.is-fallback .rava-fb__stage { aspect-ratio: auto; transform: none; }\n  .rava-fb.is-fallback .rava-fb__book { position: static; opacity: 1; overflow: visible; display: grid; gap: 16px; }\n  .rava-fb.is-fallback .rava-fb__page { position: relative; aspect-ratio: 2000 / 1410; box-shadow: 0 10px 30px rgba(0,0,0,.08); }\n  .rava-fb.is