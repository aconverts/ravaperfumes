n      };\n      document.head.appendChild(s);\n    })();\n  }\n\n  function withWidth(url, w) {\n    if (!url) return url;\n    return url + (url.indexOf('?') > -1 ? '&' : '?') + 'width=' + w;\n  }\n\n  function init(root) {\n    if (!root || root.__ravaFb) return;\n    root.__ravaFb = true;\n\n    var bookEl = root.querySelector('[data-rava-book]');\n    var stage = root.querySelector('.rava-fb__stage');\n    var col = root.querySelector('.rava-fb__col');\n    var bar = root.querySelector('.rava-fb__bar');\n    var countEl = root.querySelector('[data-rava-count]');\n    var prevBtns = root.querySelectorAll('[data-rava-prev]');\n    var nextBtns = root.querySelectorAll('[data-rava-next]');\n    var fsBtn = root.querySelector('[data-rava-fs]');\n    var pages = Array.prototype.slice.call(bookEl.querySelectorAll('.rava-fb__page'));\n    var total = pages.length;\n    if (!total) { console.warn(TAG, 'No pages found.'); return; }\n\n    var PW = +root.getAttribute('data-page-w') || 2000;\n    var PH = +root.getAttribute('data-page-h') || 1410;\n    var RATIO = PW / PH;\n    var pf = null;\n    var tier = 0;\n    var current = 0;\n    var raf = 0;\n\n    /* ---------- image loading ---------- */\n    function pickTier(pageW) {\n      var need = pageW * Math.min(window.devicePixelRatio || 1, 2);\n      for (var i = 0; i < TIERS.length; i++) if (TIERS[i] >= need) return TIERS[i];\n      return TIERS[TIERS.length - 1];\n    }\n    function loadPage(i) {\n      if (i < 0 || i >= total) return;\n      var page = pages[i];\n      var img = page.querySelector('img');\n      if (!img || page.__failed) return;\n      var have = +(img.getAttribute('data-tier') || 0);\n      if (have >= tier) return;\n      img.setAttribute('data-tier', tier);\n      var url = withWidth(img.getAttribute('data-rava-src'), tier);\n      var pre = new Image();\n      pre.decoding = 'async';\n      pre.onload = function () { img.src = url; page.classList.add('is-loaded'); };\n      pre.onerror = funct