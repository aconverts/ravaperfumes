    function prev() { if (pf) pf.flipPrev('bottom'); }\n    Array.prototype.forEach.call(nextBtns, function (b) { b.addEventListener('click', next); });\n    Array.prototype.forEach.call(prevBtns, function (b) { b.addEventListener('click', prev); });\n\n    /* Keyboard arrows when the book is on screen */\n    document.addEventListener('keydown', function (e) {\n      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;\n      var t = e.target, tag = t && t.tagName;\n      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (t && t.isContentEditable)) return;\n      if (e.key === 'Escape' && root.classList.contains('is-pseudo-fs')) { exitFs(); return; }\n      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;\n      var r = root.getBoundingClientRect();\n      var visible = isFs() || (r.bottom > 80 && r.top < (window.innerHeight - 80));\n      if (!visible) return;\n      e.preventDefault();\n      if (e.key === 'ArrowRight') next(); else prev();\n    });\n\n    /* ---------- fullscreen ---------- */\n    function nativeFsEl() { return document.fullscreenElement || document.webkitFullscreenElement || null; }\n    function setFsState(on) {\n      root.classList.toggle('is-fs', on);\n      if (fsBtn) fsBtn.setAttribute('aria-label', on ? 'Exit fullscreen' : 'Enter fullscreen');\n      scheduleFit();\n      setTimeout(fit, 350);\n    }\n    function enterPseudo() {\n      root.classList.add('is-pseudo-fs');\n      document.documentElement.style.overflow = 'hidden';\n      setFsState(true);\n    }\n    function exitFs() {\n      if (root.classList.contains('is-pseudo-fs')) {\n        root.classList.remove('is-pseudo-fs');\n        document.documentElement.style.overflow = '';\n        setFsState(false);\n        return;\n      }\n      var ex = document.exitFullscreen || document.webkitExitFullscreen;\n      if (ex && nativeFsEl()) ex.call(document);\n    }\n    function enterFs() {\n      var req = root.requestFullscreen || root