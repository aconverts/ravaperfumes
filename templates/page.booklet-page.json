va_fb_list -%}\n              <div class=\"rava-fb__page\"{% if forloop.first or forloop.last %} data-density=\"hard\"{% endif %}>\n                <img data-rava-src=\"{{ rava_fb_src | strip }}\" alt=\"RAVA booklet, page {{ forloop.index }} of {{ rava_fb_total }}\" width=\"2000\" height=\"1410\" draggable=\"false\" decoding=\"async\">\n              </div>\n            {%- endfor -%}\n          </div>\n        </div>\n      </div>\n      <div class=\"rava-fb__hint\" data-rava-hint aria-hidden=\"true\">Pinch or double-tap to zoom</div>\n    </div>\n\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__arrow rava-fb__arrow--next\" data-rava-next aria-label=\"Next page\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg>\n    </button>\n  </div>\n\n  <div class=\"rava-fb__bar\">\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__mini rava-fb__mini--nav\" data-rava-prev aria-label=\"Previous page\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>\n    </button>\n    <span class=\"rava-fb__count\" data-rava-count aria-live=\"polite\">1 / {{ rava_fb_total }}</span>\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__mini rava-fb__mini--nav\" data-rava-next aria-label=\"Next page\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg>\n    </button>\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__mini rava-fb__zbtn\" data-rava-zoom aria-label=\"Zoom in\">\n      <svg class=\"rava-fb__ico-zin\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"M15.5 15.5L20 20M10.5 7.5v6M7.5 10.5h6\"/></svg>\n      <svg class=\"rava-fb__ico-zout\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"M15.5 15.5L20 20M7.5 10.5h6\"/></svg>\n    </button>\n    <button type=\"button\" class=\"rava-fb__btn rava-fb__mini rava-fb__fs\" data-rava-fs aria-label=\"Ente