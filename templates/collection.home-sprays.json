        "liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Luxury Offer Timer</title>\n\n<style>\nbody{\n  margin:0;\n  padding:0;\n  background:#000;\n}\n\n/* MAIN BOX */\n.offer-timer{\n  max-width:520px;\n  margin: 20px auto;\n  padding:12px;\n  text-align:center;\n  background:linear-gradient(145deg,#000,#111,#000);\n  border:1px solid #efe4bf;\n  border-radius:14px;\n  box-shadow:0 0 15px rgba(239,228,191,0.18);\n  color:#efe4bf;\n  font-family:inherit;\n}\n\n/* TITLE */\n.offer-timer h2{\n  margin:0;\n  font-size:15px;\n  letter-spacing:1px;\n  font-weight:700;\n  text-transform:uppercase;\n}\n\n/* SUBTEXT */\n.offer-timer p{\n  margin:8px 0 14px;\n  font-size:11px;\n  letter-spacing:0.5px;\n  color:#d8cfae;\n}\n\n/* COUNTDOWN */\n.countdown{\n  display:flex;\n  justify-content:center;\n  align-items:center;\n  gap:8px;\n}\n\n/* TIME BOX */\n.time-box{\n  min-width:72px;\n  padding:10px 6px;\n  background:#efe4bf;\n  color:#000;\n  border-radius:10px;\n  box-shadow:0 4px 12px rgba(239,228,191,0.18);\n}\n\n.number{\n  display:block;\n  font-size:20px;\n  font-weight:700;\n  line-height:1;\n}\n\n.label{\n  display:block;\n  margin-top:4px;\n  font-size:9px;\n  letter-spacing:1px;\n  text-transform:uppercase;\n}\n\n/* MOBILE */\n@media(max-width:768px){\n  .offer-timer{\n    max-width:95%;\n    margin:12px auto;\n    padding:14px 10px;\n  }\n\n  .offer-timer h2{\n    font-size:13px;\n  }\n\n  .offer-timer p{\n    font-size:10px;\n    margin:6px 0 10px;\n  }\n\n  .countdown{\n    gap:6px;\n  }\n\n  .time-box{\n    min-width:62px;\n    padding:8px 4px;\n  }\n\n  .number{\n    font-size:16px;\n  }\n\n  .label{\n    font-size:8px;\n  }\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"offer-timer\">\n  <h2>Buy 1 Get 1 Free Offer Ending Today</h2>\n  <p>Hurry up! Limited-time deal ends soon.</p>\n\n  <div class=\"countdown\">\n    <div class=\"time-box\">\n      <span class=\"number\" id=\"offer-hours\">03</span>\n      <span class=\"label\">Hours</span>\n    </div>\n\n    <div class=\"time-box\">\n      <span class=\"number\" id=\"offer-minutes\">00</span>\n      <span class=\"label\">Minutes</span>\n    </div>\n\n    <div class=\"time-box\">\n      <span class=\"number\" id=\"offer-seconds\">00</span>\n      <span class=\"label\">Seconds</span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  let duration = 3 * 60 * 60;\n\n  const hoursEl = document.getElementById(\"offer-hours\");\n  const minutesEl = document.getElementById(\"offer-minutes\");\n  const secondsEl = document.getElementById(\"offer-seconds\");\n\n  if(!hoursEl || !minutesEl || !secondsEl) return;\n\n  function updateTimer(){\n    let hours = Math.floor(duration / 3600);\n    let minutes = Math.floor((duration % 3600) / 60);\n    let seconds = duration % 60;\n\n    hoursEl.textContent = String(hours).padStart(2,'0');\n    minutesEl.textContent = String(minutes).padStart(2,'0');\n    secondsEl.textContent = String(seconds).padStart(2,'0');\n\n    duration--;\n\n    if(duration < 0){\n      duration = 3 * 60 * 60;\n    }\n  }\n\n  updateTimer();\n  setInterval(updateTimer, 1000);\n})();\n</script>\n\n</body>\n</html>",
