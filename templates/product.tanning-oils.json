            "liquid": "<!-- 👀 Customers Viewing Section -->\n<div id=\"product-viewers-section\" style=\"margin-top: -18px; margin-bottom: -12px; font-size: 14px; font-family: inherit; display: flex; align-items: center; gap: 6px;\">\n  👀 <span id=\"viewer-count\" style=\"color: #DF694F; font-weight: 600;\">25</span>\n  <span style=\"color: #1e1e1e;\">customers are viewing this product right now</span>\n</div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const min = 2;\n    const max = 9;\n    const randomCount = Math.floor(Math.random() * (max - min + 1)) + min;\n    const viewerElement = document.getElementById(\"viewer-count\");\n    if (viewerElement) {\n      viewerElement.textContent = randomCount;\n    }\n  });\n</script>"
