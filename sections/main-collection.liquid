          "info": "t:sections.main_collection.blocks.push_promo.mobile_image_size_recommendation"
        },
        {
          "type": "video",
          "id": "video",
          "visible_if": "{{ block.settings.media_type == 'video' }}",
          "label": "t:global.video.video"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "visible_if": "{{ block.settings.media_type == 'video' }}",
          "label": "t:global.video.mobile_video",
          "info": "t:sections.main_collection.blocks.push_promo.mobile_video_info"
        },
