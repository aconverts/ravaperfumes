{%- comment -%}
  RAVA: compact "What is a niche perfume?" strip.
  Shows on products tagged with "product_tag" and on collections listed in "collection_handles".
  On those collections it also hides the sections listed in "hide_sections" (e.g. the offer banner).
{%- endcomment -%}
{%- liquid
  assign rava_show = false
  assign rava_is_pdp = false
  assign rava_tag = section.settings.product_tag | strip
  if template.name == 'product' and rava_tag != blank and product.tags contains rava_tag
    assign rava_show = true
    assign rava_is_pdp = true
  endif
  if template.name == 'collection' and collection
    assign rava_handles = section.settings.collection_handles | split: ','
    for h in rava_handles
      assign h2 = h | strip
      if h2 == collection.handle
        assign rava_show = true
        break
      endif
    endfor
  endif
  assign rava_btn_url = section.settings.button_link | default: ''
  assign rava_hide_btn = false
  if rava_btn_url == blank or request.path == rava_btn_url
    assign rava_hide_btn = true
  endif
-%}

{%- if rava_show -%}
<style>
  {%- if rava_is_pdp == false and section.settings.hide_sections != blank -%}
    {%- assign rava_hide = section.settings.hide_sections | split: ',' -%}
    {%- for s in rava_hide -%}
      {%- assign s2 = s | strip -%}
      {%- if s2 != blank -%}[id$="__{{ s2 }}"]{display:none !important;}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  #shopify-section-{{ section.id }} .rava-niche { padding-block: 16px; }
  {%- if rava_is_pdp -%}
  #shopify-section-{{ section.id }} { margin-top: calc(-1 * var(--section-vertical-spacing-tight, 32px) + 8px); position: relative; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .rava-niche__card {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 720px;
    margin-inline: auto;
    padding: 12px;
    background: {{ section.settings.background }};
    color: #000;
    border-radius: 14px;
  }
  #shopify-section-{{ section.id }} .rava-niche__img {
    flex: 0 0 64px;
    width: 64px;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }
  #shopify-section-{{ section.id }} .rava-niche__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .rava-niche__body { min-width: 0; flex: 1; }
  #shopify-section-{{ section.id }} .rava-niche__title { margin: 0 0 2px; font-size: 14px; line-height: 1.3; }
  #shopify-section-{{ section.id }} .rava-niche__text { margin: 0; font-size: 13px; line-height: 1.45; opacity: .85; }
  #shopify-section-{{ section.id }} .rava-niche__link {
    display: inline-block;
    margin-top: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .rava-niche { padding-block: 24px; }
    #shopify-section-{{ section.id }} .rava-niche__card { gap: 18px; padding: 14px; }
    #shopify-section-{{ section.id }} .rava-niche__img { flex-basis: 84px; width: 84px; }
    #shopify-section-{{ section.id }} .rava-niche__title { font-size: 16px; }
    #shopify-section-{{ section.id }} .rava-niche__text { font-size: 14px; }
  }
</style>

<div class="rava-niche">
  <div class="container">
    <div class="rava-niche__card">
      {%- if section.settings.image != blank -%}
        <div class="rava-niche__img">
          {{- section.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '(min-width: 700px) 84px, 64px', widths: '128,168,300', alt: section.settings.image.alt | default: section.settings.title -}}
        </div>
      {%- endif -%}
      <div class="rava-niche__body">
        {%- if section.settings.title != blank -%}
          <h2 class="h6 rava-niche__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="rava-niche__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank and rava_hide_btn == false -%}
          <a href="{{ rava_btn_url }}" class="rava-niche__link">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "RAVA niche info",
  "class": "shopify-section--rava-niche-info",
  "settings": [
    { "type": "paragraph", "content": "Shows only on products with the tag below, and on the collections listed below." },
    { "type": "text", "id": "product_tag", "label": "Show on products tagged", "default": "niche-perfumes" },
    { "type": "text", "id": "collection_handles", "label": "Show on collections (handles, comma separated)", "default": "niche-perfumes, niche-perfumes-for-him, niche-perfumes-for-her" },
    { "type": "text", "id": "hide_sections", "label": "Hide sections on these collections", "info": "Section IDs, comma separated. Used to hide the offer banner." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F3F3C8" },
    { "type": "text", "id": "title", "label": "Heading", "default": "What is a niche perfume?" },
    { "type": "text", "id": "text", "label": "Text", "default": "A scent from a house that makes only perfume, like Kayali, Xerjoff or Creed: rarer, bolder and made to stand out." },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop niche perfumes" },
    { "type": "url", "id": "button_link", "label": "Link", "info": "Hidden when the visitor is already on this page." }
  ],
  "presets": [{ "name": "RAVA niche info" }]
}
{% endschema %}
