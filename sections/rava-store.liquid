{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  RAVA STORE
  ----------------------------------------------------------------------------------------------------------------------

  Clean store announcement: photo + "Now open" label, heading, short text, address and hours, an optional opening
  offer, and two buttons (Get directions / WhatsApp). Answers the "I can't smell it online" doubt.
{%- endcomment -%}

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<style>
  #shopify-section-{{ section.id }} .rst {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .rst__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    background: rgb(var(--text-color) / 0.06);
  }

  #shopify-section-{{ section.id }} .rst__media img,
  #shopify-section-{{ section.id }} .rst__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .rst__content {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  #shopify-section-{{ section.id }} .rst__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--heading-font-family);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .rst__dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #22CD5B;
    box-shadow: 0 0 0 0 rgb(34 205 91 / 0.5);
    animation: rst-pulse 2s ease-out infinite;
  }

  @keyframes rst-pulse {
    0% { box-shadow: 0 0 0 0 rgb(34 205 91 / 0.5); }
    70% { box-shadow: 0 0 0 8px rgb(34 205 91 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(34 205 91 / 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .rst__dot { animation: none; }
  }

  #shopify-section-{{ section.id }} .rst__content .h2 {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .rst__text {
    margin: 0;
    max-width: 34rem;
    color: rgb(var(--text-color) / 0.75);
  }

  #shopify-section-{{ section.id }} .rst__details {
    display: grid;
    gap: 0.625rem;
    width: 100%;
    margin: 0;
    padding: 1rem 0;
    border-block: 1px solid rgb(var(--text-color) / 0.15);
    list-style: none;
  }

  #shopify-section-{{ section.id }} .rst__detail {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    font-size: 14px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .rst__detail svg {
    margin-top: 1px;
  }

  #shopify-section-{{ section.id }} .rst__offer {
    margin: 0;
    padding: 0.5rem 0.75rem;
    background: {{ section.settings.offer_background }};
    color: #000;
    font-family: var(--heading-font-family);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .rst__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .rst__buttons > * {
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .rst__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #22CD5B;
    border-color: #22CD5B;
    color: #000;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .rst {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 4.5rem;
    }

    #shopify-section-{{ section.id }} .rst__media {
      aspect-ratio: 5 / 4;
      {%- if section.settings.image_position == 'right' -%}order: 2;{%- endif -%}
    }

    #shopify-section-{{ section.id }} .rst__buttons > * {
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .rst__detail {
      font-size: 15px;
    }
  }
</style>

<div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container">
    <div class="rst">
      <div class="rst__media">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: section.settings.image.width | image_tag:
            loading: 'lazy',
            sizes: '(max-width: 999px) 100vw, 55vw',
            widths: '400,600,800,1000,1200,1400,1600',
            alt: section.settings.image.alt | default: section.settings.heading
          -}}
        {%- else -%}
          {{- 'lifestyle-2' | placeholder_svg_tag -}}
        {%- endif -%}
      </div>

      <div class="rst__content">
        {%- if section.settings.label != blank -%}
          <p class="rst__label">
            {%- if section.settings.show_dot -%}<span class="rst__dot" aria-hidden="true"></span>{%- endif -%}
            {{- section.settings.label -}}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="prose rst__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.address != blank or section.settings.hours != blank -%}
          <ul class="rst__details" role="list">
            {%- if section.settings.address != blank -%}
              <li class="rst__detail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                <span>{{ section.settings.address }}</span>
              </li>
            {%- endif -%}

            {%- if section.settings.hours != blank -%}
              <li class="rst__detail">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                <span>{{ section.settings.hours }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.offer != blank -%}
          <p class="rst__offer">{{ section.settings.offer }}</p>
        {%- endif -%}

        {%- liquid
          assign wa_number = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
          assign wa_message = section.settings.whatsapp_message | url_encode
        -%}

        {%- if section.settings.directions_url != blank or wa_number != blank -%}
          <div class="rst__buttons">
            {%- if section.settings.directions_url != blank -%}
              {%- render 'button', href: section.settings.directions_url, content: section.settings.directions_text, external: true -%}
            {%- endif -%}

            {%- if wa_number != blank -%}
              <a class="button rst__wa" href="https://wa.me/{{ wa_number }}{% if wa_message != blank %}?text={{ wa_message }}{% endif %}" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.5-4A8 8 0 1 1 8 18.5L4 20z"></path></svg>
                {{- section.settings.whatsapp_text -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "RAVA store",
  "class": "shopify-section--rava-store",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Store photo",
      "info": "A photo of the Centro Mall store. Landscape works best (for example 2000 x 1500 px)."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photo position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Now open · Centro Mall"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show green 'open' dot",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Smell it before you buy it"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Visit our new store in Centro Mall. Test any scent on your skin, then take it home or order online.</p>"
    },
    {
      "type": "header",
      "content": "Store details"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Centro Mall, [floor / unit], [area]"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Opening hours",
      "default": "Every day, [10:00] to [22:00]"
    },
    {
      "type": "text",
      "id": "offer",
      "label": "In-store offer",
      "info": "Optional. Leave empty to hide."
    },
    {
      "type": "color",
      "id": "offer_background",
      "label": "Offer background",
      "default": "#F3F4B5"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "directions_text",
      "label": "Directions button",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Google Maps link",
      "info": "Open the store in Google Maps, tap Share, copy the link and paste it here."
    },
    {
      "type": "text",
      "id": "whatsapp_text",
      "label": "WhatsApp button",
      "default": "WhatsApp us"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "With country code, for example +961 70 123 456. Leave empty to hide the button."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Pre-filled message",
      "default": "Hi RAVA, I'd like to visit the Centro Mall store."
    }
  ],
  "presets": [
    {
      "name": "RAVA store"
    }
  ]
}
{% endschema %}
