{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  LINE ITEM
  ----------------------------------------------------------------------------------------------------------------------

  This component renders a single line item product information, and is used on order and cart page.

  ********************************************
  Supported variables
  ********************************************

  * line_item: the line item to render (required)
  * show_quantity_selector: if set to true, the quantity selector is displayed (useful for instance of mini-cart)
{%- endcomment -%}

{%- liquid
  # RAVA: a line is a free gift when a discount brings one or more of its units to $0 (Roll On / Hair Mist from the offer)
  assign rava_free_units = 0
  if line_item.original_price > 0 and line_item.final_line_price < line_item.original_line_price
    assign rava_saved = line_item.original_line_price | minus: line_item.final_line_price
    assign rava_free_units = rava_saved | divided_by: line_item.original_price
  endif
  # Gifts chosen in the gift picker are always shown as gifts
  if line_item.properties['_rava_gift'] != blank and rava_free_units < line_item.quantity
    assign rava_free_units = line_item.quantity
  endif
-%}

{%- if rava_free_units >= line_item.quantity and rava_free_units > 0 and show_quantity_selector -%}
  {%- comment -%} RAVA: compact one-row gift line in the cart drawer {%- endcomment -%}
  {%- assign rava_short = line_item.product.title | default: line_item.title | remove: ' 50ml' | remove: ' 100ml' -%}
  <line-item class="line-item line-item--gift line-item--gift-compact">
    {%- if line_item.image != blank -%}
      {{- line_item.image | image_url: width: 96 | image_tag: loading: 'lazy', class: 'lig__media', alt: '' -}}
    {%- endif -%}

    <div class="lig__info">
      <span class="line-item__gift-badge">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4"></rect><path d="M5 12v9h14v-9M12 8v13M12 8c-1.5-3.5-6-4-6-1.2C6 8.5 12 8 12 8zM12 8c1.5-3.5 6-4 6-1.2C18 8.5 12 8 12 8z"></path></svg>
        Free
      </span>
      <span class="lig__title">{{ rava_short }}{% if line_item.quantity > 1 %} &times;{{ line_item.quantity }}{% endif %}</span>
      <span class="lig__price">
        {%- if line_item.final_line_price == 0 -%}
          <s>{{ line_item.original_line_price | money }}</s> <strong>$0</strong>
        {%- elsif line_item.final_line_price < line_item.original_line_price -%}
          <s>{{ line_item.original_line_price | money }}</s> {{ line_item.final_line_price | money }}
        {%- else -%}
          {{ line_item.final_line_price | money }}
        {%- endif -%}
      </span>
    </div>

    <line-item-quantity class="lig__remove-wrap">
      <a href="{{ line_item.url_to_remove }}" class="lig__remove" aria-label="{{ 'cart.order.remove_with_title' | t: title: line_item.title | escape }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </a>
    </line-item-quantity>
  </line-item>
{%- else -%}

<line-item class="line-item{% if rava_free_units > 0 %} line-item--gift{% endif %}">
  {%- if line_item.image != blank -%}
    {{-
      line_item.image
      | image_url: width: line_item.image.width
      | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 70px, 120px', widths: '70,120,140,210,240,360', class: 'line-item__media'
    -}}
  {%- endif -%}

  <div class="line-item-info">
    {%- assign text_class = '' -%}

    {%- if settings.product_card_text_font == 'heading' -%}
      {%- assign text_class = 'h6' -%}
    {%- endif -%}

    <div class="v-stack justify-items-start gap-2">
      {%- if settings.show_vendor and line_item.vendor != blank -%}
        {%- capture vendor_class -%}smallcaps {% if settings.product_card_text_font == 'heading' %}heading{% endif %}{% endcapture %}
        {%- render 'vendor' with line_item.vendor, class: vendor_class -%}
      {%- endif -%}

      <div class="v-stack justify-items-start gap-1">
        {%- if rava_free_units > 0 -%}
          <span class="line-item__gift-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4"></rect><path d="M5 12v9h14v-9M12 8v13M12 8c-1.5-3.5-6-4-6-1.2C6 8.5 12 8 12 8zM12 8c1.5-3.5 6-4 6-1.2C18 8.5 12 8 12 8z"></path></svg>
            {%- if rava_free_units >= line_item.quantity -%}
              {%- if line_item.quantity > 1 %}{{ line_item.quantity }} free gifts{% else %}Free gift{% endif -%}
            {%- else -%}
              {{ rava_free_units }} free {% if rava_free_units == 1 %}gift{% else %}gifts{% endif %}
            {%- endif -%}
          </span>
        {%- endif -%}

        {%- if show_quantity_selector -%}<div class="lin-title">{%- endif -%}
        {%- if line_item.url != blank -%}
          <a href="{{ line_item.url }}" class="{{ text_class }}">{{ line_item.product.title | default: line_item.title }}</a>
        {%- else -%}
          <p class="{{ text_class }}">{{ line_item.product.title | default: line_item.title }}</p>
        {%- endif -%}
        {%- if show_quantity_selector -%}
          {%- comment -%} RAVA: offer name as a small tag next to the title (cart drawer) {%- endcomment -%}
          {%- for discount_allocation in line_item.line_level_discount_allocations -%}
            <span class="lin-tag">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 12V3h9l9 9-9 9-9-9zm5-6a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"></path></svg>
              {{- discount_allocation.discount_application.title | escape -}}
              {%- if discount_allocation.amount > 0 %} -{{ discount_allocation.amount | money }}{%- endif -%}
            </span>
          {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if show_quantity_selector -%}
          {%- comment -%} RAVA: price and size on one line in the cart {%- endcomment -%}
          <div class="lin-meta">
            {%- render 'price-list', line_item: line_item, context: 'line_item' -%}
            {%- unless line_item.product.has_only_default_variant or line_item.gift_card -%}
              <span class="lin-meta__variant">{{ line_item.variant.title }}</span>
            {%- endunless -%}
          </div>
        {%- else -%}
          {%- render 'price-list', line_item: line_item, context: 'line_item' -%}
        {%- endif -%}
      </div>

      {%- capture secondary_information -%}
        {%- unless line_item.product.has_only_default_variant or line_item.gift_card or show_quantity_selector -%}
          <p class="smallcaps text-subdued">{{ line_item.variant.title }}</p>
        {%- endunless -%}

        {%- if line_item.selling_plan_allocation -%}
          <p class="text-subdued">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}

        {%- unless line_item.properties == empty -%}
          <ul class="text-subdued">
            {%- for property in line_item.properties -%}
              {%- assign first_character_in_key = property.first | truncate: 1, '' -%}

              {%- if property.last == blank or first_character_in_key == '_' -%}
                {%- continue -%}
              {%- endif -%}

              <li>
                {%- if property.last contains '/uploads/' or property.last contains '/files/' -%}
                  <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                {%- else -%}
                  {{ property.first }}: {{ property.last }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endunless -%}
      {%- endcapture -%}

      {%- if secondary_information != blank -%}
        <div class="v-stack justify-items-start gap-1">
          {{- secondary_information -}}
        </div>
      {%- endif -%}

      {%- if show_quantity_selector -%}
        <line-item-quantity class="h-stack gap-4 {% if request.page_type == 'cart' %}sm:hidden{% endif %}">
          {%- render 'quantity-selector', line_item: line_item, size: 'sm' -%}

          <a href="{{ line_item.url_to_remove }}" class="link text-xs" aria-label="{{ 'cart.order.remove_with_title' | t: title: line_item.title | escape }}">
            {{- 'cart.order.remove' | t -}}
          </a>
        </line-item-quantity>
      {%- else -%}
        <p class="text-subdued text-sm sm:hidden">{{ 'customer.order.quantity' | t }}: {{ line_item.quantity }}</p>
      {%- endif -%}

      {%- assign rava_visible_discounts = 0 -%}
      {%- for da in line_item.line_level_discount_allocations -%}
        {%- if da.amount > 0 -%}{%- assign rava_visible_discounts = rava_visible_discounts | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if rava_visible_discounts > 0 and show_quantity_selector != true -%}
        <ul class="v-stack justify-items-start gap-1 unstyled-list" role="list">
          {%- for discount_allocation in line_item.line_level_discount_allocations -%}
            {%- if discount_allocation.amount == 0 -%}{%- continue -%}{%- endif -%}
            <li class="discount-badge text-xs">
              {%- render 'icon' with 'discount', width: 12 -%}
              {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})

              {%- if section.settings.allow_discount_application and discount_allocation.discount_application.type != '' -%}
                <cart-discount-remove-button discount-code="{{ discount_allocation.discount_application.title }}" class="h-stack align-center">
                  <button type="button">{%- render 'icon' with 'close', width: 8 -%}</button>
                </cart-discount-remove-button>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</line-item>
{%- endif -%}
