{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  RAVA HELPER TILE
  ----------------------------------------------------------------------------------------------------------------------

  A small "need help?" tile placed inside the collection grid (for example after the 3rd row), for customers who are
  stuck choosing. Phones: a full-width strip between product rows. Desktop: takes one product slot.

  ********************************************
  Supported variables
  ********************************************

  * block: the "RAVA helper tile" block of the main collection section
{%- endcomment -%}

{%- liquid
  assign s = block.settings
  assign tile_url = s.link

  if s.action == 'whatsapp'
    assign wa_number = s.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
    assign wa_text = s.whatsapp_message | replace: '[collection]', collection.title | url_encode
    assign tile_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text
  endif
-%}

<div class="product-list__promo rht" style="--product-list-promo-column-span: 1; --rht-bg: {{ s.background }};" {{ block.shopify_attributes }}>
  <div class="rht__inner">
    <span class="rht__icon" aria-hidden="true">
      {%- case s.icon -%}
        {%- when 'whatsapp' -%}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4 20l1.5-4A8 8 0 1 1 8 18.5L4 20z"></path><path d="M9.5 9.5c0 2.5 2 4.5 5 5" stroke-linecap="round"></path></svg>
        {%- when 'store' -%}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
        {%- when 'gift' -%}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4"></rect><path d="M5 12v9h14v-9M12 8v13M12 8c-1.5-3.5-6-4-6-1.2C6 8.5 12 8 12 8zM12 8c1.5-3.5 6-4 6-1.2C18 8.5 12 8 12 8z"></path></svg>
        {%- else -%}
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
      {%- endcase -%}
    </span>

    <div class="rht__copy">
      {%- if s.title != blank -%}<p class="rht__title">{{ s.title }}</p>{%- endif -%}
      {%- if s.text != blank -%}<p class="rht__text">{{ s.text }}</p>{%- endif -%}
    </div>

    {%- if s.button_text != blank and tile_url != blank -%}
      <a
        href="{{ tile_url }}"
        class="button rht__button{% if s.action == 'whatsapp' %} rht__button--wa{% endif %}"
        {% if s.action == 'whatsapp' or s.open_new_tab %}target="_blank" rel="noopener"{% endif %}
      >
        {{- s.button_text -}}
      </a>
    {%- endif -%}
  </div>
</div>
